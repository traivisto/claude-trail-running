{
  "mcpServers": {
    "garmin": {
      "command": "cmd",
      "args": [
        "/c",
        "uvx",
        "--python", "3.12",
        "--from", "git+https://github.com/Taxuspt/garmin_mcp",
        "garmin-mcp"
      ]
    },
    "oura": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@daveremy/oura-mcp@0.1.5"
      ],
      "env": {
        "OURA_TOKEN": "YOUR_OURA_TOKEN_HERE"
      }
    }
  }
}
