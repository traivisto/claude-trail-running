# Personal athlete data lives in athletes/<id>/ — never commit it
# (each athlete directory may be its own separate private git repo)
athletes/*
!athletes/.gitkeep

# Dev-local archive (old plugin builds, eval workspaces) — may contain personal data
docs/archive/

# Legacy root locations — kept for one release so a half-migrated checkout cannot leak
athlete-profile.md
race-card.md
race-day-guide.md
training-program.md
current-plan.md
events-log.md
memory.md
activity-cache.csv
aerobic-efficiency-splits.csv
training-dashboard.html

# Runtime / generated files
oura-today.json
telegram-last-update.txt
__pycache__/
*.pyc

# Credentials — kept in ~/mcps/ but gitignore as safety net
oura.env
telegram-trail-coach.json
*.env

# Archives and personal history
arkisto/

# Personal drafts and notes — not for the public repo
blog-post-draft.md
linkedin-post-draft.md
telegram-conversation-log.md
lunttikortti_*

# setup-template/ contains blank starter files — include them despite the rules above
!setup-template/
!setup-template/**
